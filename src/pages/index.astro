---
const modes = [
  { n: '٠١', title: 'هەر پیتێک، دەستپێکی چیرۆکێکە', text: 'پیتەکان پێکەوە ببەستە، وشەکان بدۆزەوە و هەنگاو بە هەنگاو بەرەو پێش بچۆ.', icon: '✦' },
  { n: '٠٢', title: 'گەشتێک بە ڕەنگی کوردستان', text: 'لە نەخشەی یارییەکەدا بگەڕێ و لەگەڵ هەر قۆناغێک، ئاستەنگێکی تازە تاقی بکەرەوە.', icon: '☀' },
  { n: '٠٣', title: 'هاوڕێکانت بانگهێشت بکە', text: 'لە یاریی دوو کەسیدا خێرایی و زانیاریی وشەکانت تاقی بکەرەوە.', icon: '⚡' },
];
---
<!doctype html>
<html lang="ckb" dir="rtl">
<head>
<meta name="robots" content="noindex, nofollow, noarchive" />
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>پلەپیت — هەر وشەیەک، سەرەتای گەشتێک</title>
<meta name="description" content="پلەپیت، یاریی وشەی کوردی سۆرانی. پیتەکان پێکەوە ببەستە، وشە بدۆزەوە و بە کوردستاندا بگەڕێ. بەزووانە بۆ ئەندرۆید و ئایفۆن." />
<meta name="theme-color" content="#ffffff" /><meta property="og:title" content="پلەپیت — هەر وشەیەک، سەرەتای گەشتێک" /><meta property="og:description" content="یاریی وشەی کوردی سۆرانی. بەزووانە بۆ ئەندرۆید و ئایفۆن." /><meta property="og:type" content="website" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preload" href="/fonts/regular.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body>
<a class="skip" href="#main">بڕۆ بۆ ناوەڕۆک</a>
<header class="wrap"><a class="brand" href="#" aria-label="پلەپیت، سەرەتا"><span class="sun">☀</span> پلەپیت<span class="latin" lang="en">PILEPIT</span></a><nav aria-label="ڕێنیشاندەر"><a href="#experience">ئەزموونی یاری</a><a href="#questions">پرسیارەکان</a></nav><a class="nav-cta" href="#download">بەزووانە ↗</a></header>
<main id="main">
<section class="hero wrap"><div class="hero-wordmark" aria-hidden="true">PILEPIT</div>
<div class="hero-copy"><p class="eyebrow"><span></span> وشەکانمان، جیهانێکن</p><h1>هەر وشەیەک،<br/>سەرەتای <em>گەشتێک.</em></h1><p class="intro">پیتێک لێرە، وشەیەک لەوێ.<br/>لەگەڵ پلەپیت، خۆشیی دۆزینەوە بە زمانی خۆت ئەزموون بکە.</p><div class="stores" id="download"><button type="button" aria-describedby="release"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3 15 12 4 21Z M16 11l4 2-4 2" fill="currentColor"/></svg><span><small>بەزووانە لە</small><b lang="en" dir="ltr">Google Play</b></span></button><button type="button" aria-describedby="release"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3c0 2-2 4-4 4 0-2 2-4 4-4M18 8c-3-2-4 0-6 0S9 6 6 8c-5 4 0 14 3 13l3-1 3 1c2 0 4-4 5-6-3-1-4-4-2-7" fill="currentColor"/></svg><span><small>بەزووانە لە</small><b lang="en" dir="ltr">App Store</b></span></button></div><p class="release" id="release" role="status">یارییەکە هێشتا بڵاو نەکراوەتەوە. چاوەڕوانمان بن!</p><div class="hero-notes"><span>✦ بە کوردی سۆرانی</span><span>◌ بۆ ئەندرۆید و ئایفۆن</span></div></div>
<div class="showcase"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="floating letter-one">پ</span><span class="floating letter-two">ڵ</span><span class="spark">✦</span><div class="phone"><div class="speaker"></div><img src="/images/gameplay.png" alt="نمای یاریی پلەپیت؛ خشتەی وشەکان و بازنەی پیتە کوردییەکان" width="411" height="914" fetchpriority="high" /></div><div class="float-label"><span>✧</span> خۆشی لە دۆزینەوەدایە</div></div>
</section>
<div class="ticker" aria-hidden="true"><span>پیتەکان پێکەوە ببەستە</span>✦<span>وشەکان بدۆزەوە</span>✦<span>بە زمانی خۆت یاری بکە</span>✦<span>گەشتەکەت دەست پێ بکە</span></div>
<section class="experience wrap" id="experience"><div class="section-top"><div><p class="eyebrow">تەنها یارییەکی وشە نییە</p><h2>کەمێک بیرکردنەوە.<br/><span>زۆرێک خۆشی.</span></h2></div><p>لە یەکەم وشەوە تا دوا ئاستەنگ،<br/>هەمیشە شتێکی تازە چاوەڕێتە.</p></div><div class="features">{modes.map(mode => <article><div class="card-top"><span class="mode-icon">{mode.icon}</span><span>{mode.n}</span></div><h3>{mode.title}</h3><p>{mode.text}</p></article>)}</div></section>
<section class="product-gallery wrap" aria-label="PILEPIT"><div class="scene violet"><span class="scene-number">01 / PILEPIT</span><img src="/images/gameplay.png" alt="PILEPIT" width="411" height="914" loading="lazy" /></div><div class="scene teal"><span class="scene-number">02 / PILEPIT</span><img src="/images/duel.png" alt="PILEPIT" width="411" height="914" loading="lazy" /></div></section><section class="journey wrap"><div class="journey-image"><img src="/images/map.png" alt="نەخشەی قۆناغەکانی پلەپیت" width="411" height="914" loading="lazy" /></div><div><p class="eyebrow">ئاشنا، بەڵام پڕ لە دۆزینەوە</p><h2>زمانی خۆمان.<br/>ڕەنگی <em>خۆمان.</em></h2><p>پلەپیت گەشتێکە بە ناو وشە و ڕەنگە ئاشناکاندا. پیتەکان پێکەوە دەبەستیت و لە هەر قۆناغێکدا وشەیەکی نوێ دەدۆزیتەوە.</p><a class="text-link" href="#download">ئامادەی گەشتێکی تازەیت؟ ←</a></div></section>
<section class="faq wrap" id="questions"><p class="eyebrow">پێش دەستپێکردن</p><h2>ئەوەی دەتەوێت بیزانیت</h2><details><summary>پلەپیت چییە؟</summary><p>پلەپیت یارییەکی وشەی کوردی سۆرانییە؛ پیتەکان پێکەوە دەبەستیت بۆ دۆزینەوەی وشەکان و تەواوکردنی قۆناغەکان.</p></details><details><summary>کەی دەتوانم دایبەزێنم؟</summary><p>بەزووانە لە Google Play و App Store بەردەست دەبێت. کاتێک بڵاو کرایەوە، بەستەرەکانی داگرتن لێرە زیاد دەکرێن.</p></details><details><summary>بۆ کام مۆبایل بەردەست دەبێت؟</summary><p>پلەپیت بۆ مۆبایلەکانی ئەندرۆید و ئایفۆن ئامادە دەکرێت.</p></details></section>
<section class="closing wrap"><span class="sun">☀</span><h2>گەشتێکی گەورە،<br/>بە وشەیەکی بچووک دەست پێ دەکات.</h2><a href="#download" class="nav-cta">بەزووانە دێین ↗</a></section>
</main><footer class="wrap"><a href="#" class="brand">☀ پلەپیت</a><p>بە زمانی خۆمان، بۆ خۆشیی هەموومان.</p><span lang="en" dir="ltr">© {new Date().getFullYear()} PILEPIT</span></footer>
<script>document.querySelectorAll('.stores button').forEach(button => button.addEventListener('click', () => { const status = document.querySelector('#release'); if (status) { status.textContent = 'بەزووانە! بەستەری داگرتن دوای بڵاوکردنەوەی یاری چالاک دەبێت.'; } }));</script>
<style is:global>
@font-face{font-family:Vazir;src:url('/fonts/regular.ttf') format('truetype');font-weight:400;font-display:swap}@font-face{font-family:Vazir;src:url('/fonts/bold.ttf') format('truetype');font-weight:700;font-display:swap}
:root{--violet:#5d48db;--ink:#000;--paper:#fff;--line:#e0e0e0;--muted:#686868;--shadow:0 27px 104px #0000001f;--radius:30px}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:140px}body{margin:0;background:var(--paper);color:var(--ink);font-family:Vazir,sans-serif;font-weight:400;line-height:1.9}a{color:inherit;text-decoration:none}button{font:inherit}a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--violet);outline-offset:6px}.wrap{width:min(1200px,calc(100% - 64px));margin-inline:auto}header.wrap{position:sticky;top:20px;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:20px;background:#fff;border-radius:52px;padding:16px 28px;box-shadow:0 8px 30px #0000000f}.brand{display:flex;align-items:center;gap:12px;font-size:28px;font-weight:400}.sun{font-size:32px;color:#000}.latin{font:400 11px Arial,sans-serif;letter-spacing:2px;direction:ltr}nav{display:flex;gap:32px;font-size:14px}nav a:hover,.text-link:hover{color:var(--violet)}.nav-cta{display:inline-block;border:1px solid #000;border-radius:30px;padding:12px 22px;background:#fff;font-size:14px}.hero{padding-top:100px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:0}.hero-copy{width:100%}.eyebrow{font-size:14px;color:var(--muted);margin:0 0 24px}.eyebrow span{display:none}h1{color:var(--violet);font-size:clamp(56px,8.2vw,110px);font-weight:400;line-height:1.45;letter-spacing:-.025em;margin:0 auto 40px;max-width:1100px}em{font-style:normal}h2{font-size:clamp(36px,4.2vw,56px);font-weight:400;line-height:1.6;margin:0 0 28px;letter-spacing:-.017em}.intro{font-size:18px;line-height:1.9;color:var(--muted);margin:0 auto 32px}.stores{display:flex;justify-content:center;gap:16px;scroll-margin-top:150px}.stores button{background:#fff;border:1px solid #000;border-radius:30px;padding:15px 24px;color:#000;display:flex;align-items:center;gap:14px;cursor:pointer;transition:box-shadow .2s,transform .2s}.stores button:hover,.nav-cta:hover{box-shadow:0 8px 30px #00000010;transform:translateY(-2px)}.stores svg{width:25px;height:25px}.stores span{display:grid;text-align:start;line-height:1.5}.stores small{font-size:11px;color:#666}.stores b{font:400 18px Arial,sans-serif}.release{font-size:12px;color:#686868;min-height:26px;margin:20px 0}.hero-notes{display:flex;justify-content:center;gap:28px;font-size:13px;color:#686868;margin-top:24px}.showcase{position:relative;isolation:isolate;display:flex;justify-content:center;align-items:center;width:100%;padding:70px 0 40px;min-height:760px}.showcase:before{content:'';position:absolute;inset:12% 10% 0;background:radial-gradient(ellipse,#9685ff30,transparent 65%);z-index:-1}.phone{position:relative;width:300px;height:648px;border:7px solid #262626;border-radius:45px;overflow:hidden;background:#14183a;box-shadow:0 9px 46px #00000040}.phone img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}.speaker{position:absolute;top:7px;left:36%;width:28%;height:13px;border-radius:30px;background:#171717;z-index:1}.hero-wordmark,.orbit,.floating,.spark,.float-label,.ticker{display:none}.experience{padding-block:100px 0;text-align:center}.section-top{max-width:800px;margin:0 auto 64px;text-align:center}.section-top>p{font-size:18px;color:var(--muted)}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.features article{padding:32px;background:#fff;border-radius:30px;box-shadow:0 8px 127px #00000012}.card-top{display:flex;flex-direction:column;align-items:center;gap:24px;color:#686868;font-size:12px}.mode-icon{width:100px;height:100px;border-radius:45px;background:#fff;display:grid;place-items:center;color:#000;font-size:40px;box-shadow:var(--shadow)}.features h3{font-size:24px;font-weight:400;line-height:1.7;margin:32px 0 20px}.features p{font-size:16px;color:var(--muted);line-height:1.9}.product-gallery{display:grid;grid-template-columns:1fr 1fr;gap:32px;padding-block:100px 0}.scene{height:610px;overflow:hidden;border-radius:45px;background:#fff;box-shadow:var(--shadow);padding:32px;text-align:center}.scene-number{font:400 12px Arial,sans-serif;letter-spacing:3px;color:#686868;direction:ltr}.scene img{display:block;width:260px;height:auto;margin:40px auto 0;border:6px solid #292929;border-radius:36px;box-shadow:0 9px 46px #00000025}.journey{display:flex;flex-direction:column;align-items:center;text-align:center;gap:56px;padding-top:120px}.journey>div:last-child{order:-1;max-width:690px}.journey p{font-size:18px;color:var(--muted);line-height:2}.text-link{display:inline-block;border-bottom:1px solid #000;font-size:16px;margin-top:20px;padding-bottom:6px}.journey-image{height:460px;width:min(100%,600px);overflow:hidden;border-radius:45px;box-shadow:var(--shadow);padding:40px 32px 0}.journey-image img{display:block;width:260px;height:auto;margin:auto;border:6px solid #292929;border-radius:36px;box-shadow:0 9px 46px #00000020}.faq{max-width:800px;padding-top:120px;text-align:center}.faq h2{font-size:40px;margin-bottom:48px}details{text-align:start;border-bottom:1px solid #e0e0e0;padding:24px 0}summary{cursor:pointer;font-size:18px}details p{font-size:16px;color:var(--muted);line-height:2}.closing{text-align:center;padding-block:120px 100px}.closing>.sun{display:grid;place-items:center;width:120px;height:120px;border-radius:45px;box-shadow:var(--shadow);margin:0 auto 40px;font-size:48px}.closing h2{color:var(--violet);font-size:clamp(32px,4.2vw,56px);margin-bottom:40px}.closing .nav-cta{padding:16px 30px}footer{border-top:1px solid #f0f0f0;display:flex;align-items:center;justify-content:space-between;gap:24px;padding-block:64px}footer .brand{font-size:24px}footer p,footer>span{font-size:13px;color:#686868}.skip{position:absolute;top:-100px;padding:12px;background:#fff;z-index:20}.skip:focus{top:0}
@media(max-width:900px){.wrap{width:calc(100% - 40px)}header.wrap{padding:16px 22px}nav{gap:18px}.brand{font-size:24px}.features{grid-template-columns:1fr;gap:32px}.features article{padding:40px;max-width:640px;width:100%;margin:auto}.features p{max-width:430px;margin-inline:auto}.scene{height:550px;padding:32px 16px}.scene img{width:230px}.hero{padding-top:80px}}
@media(max-width:600px){html{scroll-padding-top:110px}.wrap{width:calc(100% - 32px)}header.wrap{top:12px;margin-top:12px;padding:12px 18px;gap:10px}.brand{gap:6px;font-size:22px}.brand .sun{display:none}.latin{font-size:8px;letter-spacing:1px}nav{display:none}.nav-cta{font-size:12px;padding:10px 16px}.hero{padding-top:68px}h1{font-size:clamp(42px,10vw,60px);line-height:1.6;margin-bottom:28px;letter-spacing:0}.intro{font-size:16px}.stores{gap:10px}.stores button{padding:13px 18px;gap:9px}.stores b{font-size:16px}.stores svg{width:20px;height:20px}.hero-notes{font-size:11px;gap:18px}.release{font-size:11px}.showcase{padding-top:50px;min-height:660px}.phone{width:265px;height:574px;border-radius:40px}.showcase:before{inset:5% -10% 0}.experience{padding-top:70px}.section-top{margin-bottom:40px}h2{font-size:32px}.section-top>p{font-size:16px}.features article{padding:32px 24px}.features h3{font-size:23px}.product-gallery{grid-template-columns:1fr;padding-top:70px;gap:32px}.scene{height:520px;border-radius:45px}.scene img{width:235px}.journey{padding-top:90px;gap:40px}.journey p{font-size:16px}.journey-image{height:400px}.journey-image img{width:230px}.faq{padding-top:90px}.faq h2{font-size:30px}summary{font-size:16px}.closing{padding-block:90px 70px}.closing h2{font-size:30px}.closing>.sun{width:100px;height:100px}footer{flex-direction:column;text-align:center;padding-block:40px}footer p{margin:0}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</body></html>
