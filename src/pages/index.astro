---
const modes = [
  { n: '٠١', title: 'هەر پیتێک، دەستپێکی چیرۆکێکە', text: 'پیتەکان پێکەوە ببەستە، وشەکان بدۆزەوە و هەنگاو بە هەنگاو بەرەو پێش بچۆ.', icon: '✦' },
  { n: '٠٢', title: 'گەشتێک بە ڕەنگی کوردستان', text: 'لە نەخشەی یارییەکەدا بگەڕێ و لەگەڵ هەر قۆناغێک، ئاستەنگێکی تازە تاقی بکەرەوە.', icon: '☀' },
  { n: '٠٣', title: 'هاوڕێکانت بانگهێشت بکە', text: 'لە یاریی دوو کەسیدا خێرایی و زانیاریی وشەکانت تاقی بکەرەوە.', icon: '⚡' },
];
---
<!doctype html>
<html lang="ckb" dir="rtl">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>وشەیار — هەر وشەیەک، سەرەتای گەشتێک</title>
<meta name="description" content="وشەیار، یاریی وشەی کوردی سۆرانی. پیتەکان پێکەوە ببەستە، وشە بدۆزەوە و بە کوردستاندا بگەڕێ. بەزووانە بۆ ئەندرۆید و ئایفۆن." />
<meta name="theme-color" content="#14183a" /><meta property="og:title" content="وشەیار — هەر وشەیەک، سەرەتای گەشتێک" /><meta property="og:description" content="یاریی وشەی کوردی سۆرانی. بەزووانە بۆ ئەندرۆید و ئایفۆن." /><meta property="og:type" content="website" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preload" href="/fonts/regular.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body>
<a class="skip" href="#main">بڕۆ بۆ ناوەڕۆک</a>
<header class="wrap"><a class="brand" href="#" aria-label="وشەیار، سەرەتا"><span class="sun">☀</span> وشەیار<span class="latin" lang="en">WESHAYAR</span></a><nav aria-label="ڕێنیشاندەر"><a href="#experience">ئەزموونی یاری</a><a href="#questions">پرسیارەکان</a></nav><a class="nav-cta" href="#download">بەزووانە ↗</a></header>
<main id="main">
<section class="hero wrap">
<div class="hero-copy"><p class="eyebrow"><span></span> وشەکانمان، جیهانێکن</p><h1>هەر وشەیەک،<br/>سەرەتای <em>گەشتێک.</em></h1><p class="intro">پیتێک لێرە، وشەیەک لەوێ.<br/>لەگەڵ وشەیار، خۆشیی دۆزینەوە بە زمانی خۆت ئەزموون بکە.</p><div class="stores" id="download"><button type="button" aria-describedby="release"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3 15 12 4 21Z M16 11l4 2-4 2" fill="currentColor"/></svg><span><small>بەزووانە لە</small><b lang="en" dir="ltr">Google Play</b></span></button><button type="button" aria-describedby="release"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3c0 2-2 4-4 4 0-2 2-4 4-4M18 8c-3-2-4 0-6 0S9 6 6 8c-5 4 0 14 3 13l3-1 3 1c2 0 4-4 5-6-3-1-4-4-2-7" fill="currentColor"/></svg><span><small>بەزووانە لە</small><b lang="en" dir="ltr">App Store</b></span></button></div><p class="release" id="release" role="status">یارییەکە هێشتا بڵاو نەکراوەتەوە. چاوەڕوانمان بن!</p><div class="hero-notes"><span>✦ بە کوردی سۆرانی</span><span>◌ بۆ ئەندرۆید و ئایفۆن</span></div></div>
<div class="showcase"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="floating letter-one">ش</span><span class="floating letter-two">و</span><span class="spark">✦</span><div class="phone"><div class="speaker"></div><img src="/images/gameplay.png" alt="نمای یاریی وشەیار؛ خشتەی وشەکان و بازنەی پیتە کوردییەکان" width="411" height="914" fetchpriority="high" /></div><div class="float-label"><span>✧</span> خۆشی لە دۆزینەوەدایە</div></div>
</section>
<div class="ticker" aria-hidden="true"><span>پیتەکان پێکەوە ببەستە</span>✦<span>وشەکان بدۆزەوە</span>✦<span>بە زمانی خۆت یاری بکە</span>✦<span>گەشتەکەت دەست پێ بکە</span></div>
<section class="experience wrap" id="experience"><div class="section-top"><div><p class="eyebrow">تەنها یارییەکی وشە نییە</p><h2>کەمێک بیرکردنەوە.<br/><span>زۆرێک خۆشی.</span></h2></div><p>لە یەکەم وشەوە تا دوا ئاستەنگ،<br/>هەمیشە شتێکی تازە چاوەڕێتە.</p></div><div class="features">{modes.map(mode => <article><div class="card-top"><span class="mode-icon">{mode.icon}</span><span>{mode.n}</span></div><h3>{mode.title}</h3><p>{mode.text}</p></article>)}</div></section>
<section class="journey wrap"><div class="journey-image"><img src="/images/map.png" alt="نەخشەی قۆناغەکانی وشەیار" width="411" height="914" loading="lazy" /></div><div><p class="eyebrow">ئاشنا، بەڵام پڕ لە دۆزینەوە</p><h2>زمانی خۆمان.<br/>ڕەنگی <em>خۆمان.</em></h2><p>وشەیار گەشتێکە بە ناو وشە و ڕەنگە ئاشناکاندا. پیتەکان پێکەوە دەبەستیت و لە هەر قۆناغێکدا وشەیەکی نوێ دەدۆزیتەوە.</p><a class="text-link" href="#download">ئامادەی گەشتێکی تازەیت؟ ←</a></div></section>
<section class="faq wrap" id="questions"><p class="eyebrow">پێش دەستپێکردن</p><h2>ئەوەی دەتەوێت بیزانیت</h2><details><summary>وشەیار چییە؟</summary><p>وشەیار یارییەکی وشەی کوردی سۆرانییە؛ پیتەکان پێکەوە دەبەستیت بۆ دۆزینەوەی وشەکان و تەواوکردنی قۆناغەکان.</p></details><details><summary>کەی دەتوانم دایبەزێنم؟</summary><p>بەزووانە لە Google Play و App Store بەردەست دەبێت. کاتێک بڵاو کرایەوە، بەستەرەکانی داگرتن لێرە زیاد دەکرێن.</p></details><details><summary>بۆ کام مۆبایل بەردەست دەبێت؟</summary><p>وشەیار بۆ مۆبایلەکانی ئەندرۆید و ئایفۆن ئامادە دەکرێت.</p></details></section>
<section class="closing wrap"><span class="sun">☀</span><h2>گەشتێکی گەورە،<br/>بە وشەیەکی بچووک دەست پێ دەکات.</h2><a href="#download" class="nav-cta">بەزووانە دێین ↗</a></section>
</main><footer class="wrap"><a href="#" class="brand">☀ وشەیار</a><p>بە زمانی خۆمان، بۆ خۆشیی هەموومان.</p><span lang="en" dir="ltr">© {new Date().getFullYear()} Weshayar</span></footer>
<script>document.querySelectorAll('.stores button').forEach(button => button.addEventListener('click', () => { const status = document.querySelector('#release'); if (status) { status.textContent = 'بەزووانە! بەستەری داگرتن دوای بڵاوکردنەوەی یاری چالاک دەبێت.'; } }));</script>
