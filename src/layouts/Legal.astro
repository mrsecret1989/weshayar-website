---
const { title, english, sections } = Astro.props;
---
<!doctype html><html lang="ckb" dir="rtl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | پلە و پیت — Pelepit</title><meta name="description" content={`${title}ی پلە و پیت، لەلایەن Hima Digital Co.، هەرێمی کوردستان، عێراق.`}/><link rel="canonical" href={`https://pelepit.com${Astro.url.pathname}`}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/brand/pelepit-180.png" /></head><body><header><a class="brand" href="/"><img class="logo" src="/brand/pelepit-96.png" width="40" height="40" alt="" /><span class="brand-name">پلە و پیت <span lang="en">Pelepit</span></span></a><a href="/">گەڕانەوە بۆ سەرەتا ←</a></header><main><p class="eyebrow" lang="en">Hima Digital Co. · Kurdistan Region, Iraq</p><h1>{title}</h1><p lang="en">{english} · Last updated: 2 November 2026</p><nav aria-label="ناوەڕۆک"><ol>{sections.map(([heading],i)=><li><a href={`#section-${i+1}`}>{heading}</a></li>)}</ol></nav>{sections.map(([heading,html],i)=><section id={`section-${i+1}`}><h2>{i+1}. {heading}</h2><p set:html={html}/></section>)}</main><footer><nav aria-label="پەڕە یاساییەکان"><a href="/privacy">تایبەتمەندی</a><a href="/terms">مەرجەکانی بەکارهێنان</a><a href="/delete-account">سڕینەوەی هەژمار</a><a href="mailto:contact@pelepit.com">contact@pelepit.com</a></nav><p lang="en">© 2026 Hima Digital Co. — Pelepit</p></footer><style is:global>@font-face{font-family:Vazir;src:url('/type/regular-v1.woff2') format('woff2');font-weight:400;font-display:swap}@font-face{font-family:Vazir;src:url('/type/bold-v1.woff2') format('woff2');font-weight:700;font-display:swap}*{box-sizing:border-box}html{scroll-padding-top:24px}body{margin:0;background:#f0eafa;color:#2c2038;font:400 16px/2.2 Vazir,system-ui}header,main,footer{width:min(860px,calc(100% - 40px));margin:auto}header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-block:25px;font-size:13px}.brand{display:flex;align-items:center;gap:9px;font-size:25px;font-weight:700;text-decoration:none}.brand [lang="en"]{display:block;font:11px Arial,sans-serif}.logo{width:40px;height:40px;border-radius:11px;flex:none}main{background:#fffafc;border:1px solid #d9cbe5;border-radius:24px;padding:40px;margin-block:15px 40px}h1{font-size:36px;line-height:1.6;margin:15px 0}h2{font-size:22px;line-height:1.8;margin:0 0 12px}section{padding-top:32px;margin-top:28px;border-top:1px solid #e6ddeb}p{margin:0 0 16px}a{color:#503469;text-underline-offset:4px}a:focus-visible{outline:2px solid #503469;outline-offset:4px}.eyebrow{font-size:12px;color:#6a5b77}aside{border:1px solid #d1b878;background:#fff2ce;padding:22px;border-radius:16px;margin-block:28px;font-size:14px}aside p{margin:8px 0 0}ol{padding-inline-start:22px;font-size:14px}footer{padding-bottom:30px;font-size:12px}footer nav{display:flex;gap:20px;flex-wrap:wrap}footer p{margin-top:20px}@media(max-width:600px){main{padding:24px}h1{font-size:29px}h2{font-size:20px}body{font-size:15px}header{font-size:11px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style></body></html>
